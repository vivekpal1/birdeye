# Required — both MCP and Wingman.
# Get a free key at https://bds.birdeye.so/
BIRDEYE_API_KEY=

# Optional — Solana RPC for any direct chain reads (Helius, QuickNode, your own).
NEXT_PUBLIC_SOLANA_RPC=

# === Verdict-generation LLM ===
# Set LLM_PROVIDER to "mimo" or "anthropic". If unset, auto-detects from which key is present.
LLM_PROVIDER=

# Xiaomi MiMo V2 (OpenAI-compatible). Free tier available.
# Sign up at https://platform.xiaomimimo.com/
XIAOMI_MIMO_API_KEY=
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MIMO_MODEL=mimo-v2-flash

# Anthropic. Required only if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
